NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://meeting:meeting@db:5432/meeting
LOG_LEVEL=info
LOG_PRETTY=false
RATE_LIMIT_ENABLED=true
# Each limit is max/minutes; defaults are ADR-013. e.g. RATE_LIMIT_REGISTER=3/60
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001
# Demo only: fixed OTP accepted by MockOtpProvider. The API refuses to start with the mock in production.
OTP_PROVIDER=mock
OTP_MOCK_CODE=112233
# Only for running the production image locally (umbrella docker-compose). Never set in a real deployment.
ALLOW_MOCK_OTP=false
